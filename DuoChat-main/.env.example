# ====================================================================
# DUOCHAT ENVIRONMENT VARIABLES (TEMPLATE)
# ====================================================================
# Obtain these from your Supabase Project Settings -> API & Auth:
# https://supabase.com/dashboard/project/_/settings/api

# Public Supabase URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anonymous Key (Anon/Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (ONLY for privileged backend operations, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Base application URL (used for generating absolute invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
